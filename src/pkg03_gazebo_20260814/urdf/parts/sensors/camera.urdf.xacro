<?xml version="1.0"?>
<robot name="camera_gazebo_module" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="camera_mount_w" value="0.012"/>
  <xacro:property name="camera_mount_d" value="0.012"/>
  <xacro:property name="camera_mount_h" value="0.06"/>
  <xacro:property name="camera_mount_mass" value="0.04"/>

  <xacro:property name="camera_len" value="0.035"/>
  <xacro:property name="camera_width" value="0.025"/>
  <xacro:property name="camera_height" value="0.025"/>
  <xacro:property name="camera_mass" value="0.03"/>

  <link name="camera_mount_link">
    <visual>
      <origin xyz="0 0 ${camera_mount_h / 2.0}" rpy="0 0 0"/>
      <geometry>
        <box size="${camera_mount_w} ${camera_mount_d} ${camera_mount_h}"/>
      </geometry>
      <material name="shaft_silver"/>
    </visual>

    <collision>
      <origin xyz="0 0 ${camera_mount_h / 2.0}" rpy="0 0 0"/>
      <geometry>
        <box size="${camera_mount_w} ${camera_mount_d} ${camera_mount_h}"/>
      </geometry>
    </collision>

    <xacro:box_inertial mass="${camera_mount_mass}" x="${camera_mount_w}" y="${camera_mount_d}" z="${camera_mount_h}">
      <origin xyz="0 0 ${camera_mount_h / 2.0}" rpy="0 0 0"/>
    </xacro:box_inertial>
  </link>

  <joint name="base_to_camera_mount_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_mount_link"/>
    <origin xyz="0.12 0 0.0025" rpy="0 0 0"/>
  </joint>

  <link name="camera_link">
    <visual>
      <geometry>
        <box size="${camera_len} ${camera_width} ${camera_height}"/>
      </geometry>
      <material name="camera_green"/>
    </visual>

    <collision>
      <geometry>
        <box size="${camera_len} ${camera_width} ${camera_height}"/>
      </geometry>
    </collision>

    <xacro:box_inertial mass="${camera_mass}" x="${camera_len}" y="${camera_width}" z="${camera_height}">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:box_inertial>
  </link>

  <joint name="camera_mount_to_camera_joint" type="fixed">
    <parent link="camera_mount_link"/>
    <child link="camera_link"/>
    <origin xyz="0.025 0 ${camera_mount_h}" rpy="0 0 0"/>
  </joint>

  <gazebo reference="camera_mount_link">
    <material>Gazebo/Grey</material>
  </gazebo>

  <gazebo reference="camera_link">
    <material>Gazebo/Green</material>

    <sensor name="camera_sensor" type="camera">
      <always_on>true</always_on>
      <update_rate>15</update_rate>
      <visualize>true</visualize>

      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>10.0</far>
        </clip>
      </camera>

      <plugin name="gazebo_ros_camera_controller" filename="libgazebo_ros_camera.so">
        <ros>
          <remapping>image_raw:=/camera/image_raw</remapping>
          <remapping>camera_info:=/camera/camera_info</remapping>
        </ros>
        <camera_name>camera</camera_name>
        <frame_name>camera_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

</robot>