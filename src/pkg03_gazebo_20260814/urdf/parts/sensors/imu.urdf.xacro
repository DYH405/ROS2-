<?xml version="1.0"?>
<robot name="imu_gazebo_module" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="imu_size" value="0.015"/>
  <xacro:property name="imu_mass" value="0.02"/>

  <link name="imu_link">
    <visual>
      <geometry>
        <box size="${imu_size} ${imu_size} 0.005"/>
      </geometry>
      <material name="imu_red"/>
    </visual>

    <collision>
      <geometry>
        <box size="${imu_size} ${imu_size} 0.005"/>
      </geometry>
    </collision>

    <xacro:box_inertial mass="${imu_mass}" x="${imu_size}" y="${imu_size}" z="0.005">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:box_inertial>
  </link>

  <joint name="base_to_imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.006" rpy="0 0 0"/>
  </joint>

  <gazebo reference="imu_link">
    <material>Gazebo/Red</material>

    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>50</update_rate>
      <visualize>true</visualize>

      <plugin name="gazebo_ros_imu_controller" filename="libgazebo_ros_imu_sensor.so">
        <ros>
          <remapping>~/out:=/imu</remapping>
        </ros>
        <frame_name>imu_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

</robot>