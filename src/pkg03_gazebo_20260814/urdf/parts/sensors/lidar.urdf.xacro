<?xml version="1.0"?>
<robot name="lidar_gazebo_module" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="lidar_mount_radius" value="0.01"/>
  <xacro:property name="lidar_mount_height" value="0.08"/>
  <xacro:property name="lidar_mount_mass" value="0.05"/>

  <xacro:property name="lidar_radius" value="0.025"/>
  <xacro:property name="lidar_height" value="0.03"/>
  <xacro:property name="lidar_mass" value="0.10"/>

  <link name="lidar_mount_link">
    <visual>
      <origin xyz="0 0 ${lidar_mount_height / 2.0}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${lidar_mount_radius}" length="${lidar_mount_height}"/>
      </geometry>
      <material name="shaft_silver"/>
    </visual>

    <collision>
      <origin xyz="0 0 ${lidar_mount_height / 2.0}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${lidar_mount_radius}" length="${lidar_mount_height}"/>
      </geometry>
    </collision>

    <xacro:cylinder_inertial mass="${lidar_mount_mass}" radius="${lidar_mount_radius}" length="${lidar_mount_height}">
      <origin xyz="0 0 ${lidar_mount_height / 2.0}" rpy="0 0 0"/>
    </xacro:cylinder_inertial>
  </link>

  <joint name="base_to_lidar_mount_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_mount_link"/>
    <origin xyz="-0.10 0 0.0025" rpy="0 0 0"/>
  </joint>

  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 ${lidar_height / 2.0}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
      <material name="lidar_dark"/>
    </visual>

    <collision>
      <origin xyz="0 0 ${lidar_height / 2.0}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
    </collision>

    <xacro:cylinder_inertial mass="${lidar_mass}" radius="${lidar_radius}" length="${lidar_height}">
      <origin xyz="0 0 ${lidar_height / 2.0}" rpy="0 0 0"/>
    </xacro:cylinder_inertial>
  </link>

  <joint name="lidar_mount_to_lidar_joint" type="fixed">
    <parent link="lidar_mount_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 ${lidar_mount_height}" rpy="0 0 0"/>
  </joint>

  <gazebo reference="lidar_mount_link">
    <material>Gazebo/Grey</material>
  </gazebo>

  <gazebo reference="lidar_link">
    <material>Gazebo/Black</material>

    <sensor name="lidar_sensor" type="ray">
      <pose>0 0 0.03 0 0 0</pose>
      <visualize>true</visualize>
      <update_rate>10</update_rate>

      <ray>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.1415926</min_angle>
            <max_angle>3.1415926</max_angle>
          </horizontal>
        </scan>

        <range>
          <min>0.12</min>
          <max>8.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>

      <plugin name="gazebo_ros_lidar_controller" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=/scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>lidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

</robot>