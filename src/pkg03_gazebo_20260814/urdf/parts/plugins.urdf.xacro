<?xml version="1.0"?>
<robot name="plugins_gazebo_module" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    差速驱动插件宏
    publish_odom_tf：是否由本插件发布 odom -> base_footprint 的 TF
      默认 true：保持原有行为，AMCL 等依赖该 TF 的节点不受影响
      置为 false：TF 交由 robot_localization(EKF) 发布，避免两条 TF 分支冲突
    注意：/odom 话题仍由插件发布（受 publish_odom 控制），只是不让它抢 TF
  -->
  <xacro:macro name="diff_drive_plugin" params="publish_odom_tf">

    <gazebo>
      <plugin name="gazebo_ros_diff_drive" filename="libgazebo_ros_diff_drive.so">

        <ros>
          <remapping>cmd_vel:=/cmd_vel</remapping>
          <remapping>odom:=/odom</remapping>
        </ros>

        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>

        <wheel_separation>0.24</wheel_separation>
        <wheel_diameter>0.10</wheel_diameter>

        <max_wheel_torque>20</max_wheel_torque>
        <max_wheel_acceleration>2.0</max_wheel_acceleration>

        <publish_odom>true</publish_odom>
        <publish_odom_tf>${publish_odom_tf}</publish_odom_tf>
        <publish_wheel_tf>true</publish_wheel_tf>

        <!--
          odometry_source：里程计数据来源，二选一
            0 = ENCODER：用左右驱动轮关节角做差速运动学积分
                          —— 位姿靠积分推算，会累积误差，z 恒为 0（平面运动）
                          —— 这是真实机器人里程计的行为，A 组对比必须用这个
            1 = WORLD  ：直接读取模型在世界坐标系下的真实位姿
                          —— 位姿即真值，误差恒为 0，z 会随物理状态变化（如翻倒）
                          —— 插件默认值就是 WORLD，故此前 /odom 与真值完全一致

          必须写整数 0/1，不能写 ENCODER/WORLD：
          源码用 Get<int>() 解析，字符串会解析失败，而 Gazebo 的 Get<int>
          在解析失败时不报错、直接返回默认值 WORLD，表现为
          「改了、build 了、重启了，行为一点没变且没有任何报错」。

          验证记录见 docs/VERIFY_ODOM_SOURCE.md：
          2026-11-10 实测 WORLD 模式下，车行驶 2.15 m / 5.03 m 两处，
          /odom 与 /gazebo/model_states 在 0.1 mm / 0.01° 精度上完全一致。
        -->
        <odometry_source>0</odometry_source>

        <odometry_frame>odom</odometry_frame>
        <robot_base_frame>base_footprint</robot_base_frame>

        <update_rate>50</update_rate>

      </plugin>
    </gazebo>

  </xacro:macro>

</robot>