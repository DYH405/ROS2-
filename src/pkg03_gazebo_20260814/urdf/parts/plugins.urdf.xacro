<?xml version="1.0"?>
<robot name="plugins_gazebo_module" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    差速驱动插件宏
    publish_odom_tf：是否由本插件发布 odom -> base_footprint 的 TF
      默认 true：保持原有行为，AMCL 等依赖该 TF 的节点不受影响
      置为 false：TF 交由 robot_localization(EKF) 发布，避免两条 TF 分支冲突
    注意：/odom 话题仍由插件发布（受 publish_odom 控制），只是不让它抢 TF
  -->
  <xacro:macro name="diff_drive_plugin" params="publish_odom_tf">

    <gazebo>
      <plugin name="gazebo_ros_diff_drive" filename="libgazebo_ros_diff_drive.so">

        <ros>
          <remapping>cmd_vel:=/cmd_vel</remapping>
          <remapping>odom:=/odom</remapping>
        </ros>

        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>

        <wheel_separation>0.24</wheel_separation>
        <wheel_diameter>0.10</wheel_diameter>

        <max_wheel_torque>20</max_wheel_torque>
        <max_wheel_acceleration>2.0</max_wheel_acceleration>

        <publish_odom>true</publish_odom>
        <publish_odom_tf>${publish_odom_tf}</publish_odom_tf>
        <publish_wheel_tf>true</publish_wheel_tf>

        <odometry_frame>odom</odometry_frame>
        <robot_base_frame>base_footprint</robot_base_frame>

        <update_rate>50</update_rate>

      </plugin>
    </gazebo>

  </xacro:macro>

</robot>