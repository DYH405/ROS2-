<?xml version="1.0"?>
<robot name="base_gazebo_module" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="PI" value="3.1415926"/>

  <xacro:property name="base_len" value="0.30"/>
  <xacro:property name="base_width" value="0.30"/>
  <xacro:property name="base_height" value="0.005"/>
  <xacro:property name="base_mass" value="1.0"/>
  <xacro:property name="base_z_offset" value="0.05"/>

  <material name="plate_gray"><color rgba="0.7 0.7 0.7 1.0"/></material>
  <material name="motor_black"><color rgba="0.2 0.2 0.2 1.0"/></material>
  <material name="shaft_silver"><color rgba="0.8 0.8 0.8 1.0"/></material>
  <material name="wheel_blue"><color rgba="0.0 0.2 0.8 1.0"/></material>
  <material name="caster_orange"><color rgba="0.9 0.4 0.0 1.0"/></material>
  <material name="lidar_dark"><color rgba="0.05 0.05 0.05 1.0"/></material>
  <material name="imu_red"><color rgba="0.8 0.0 0.0 1.0"/></material>
  <material name="camera_green"><color rgba="0.0 0.6 0.0 1.0"/></material>

  <xacro:macro name="box_inertial" params="mass x y z *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${mass}"/>
      <inertia
        ixx="${mass * (y*y + z*z) / 12.0}"
        ixy="0.0"
        ixz="0.0"
        iyy="${mass * (x*x + z*z) / 12.0}"
        iyz="0.0"
        izz="${mass * (x*x + y*y) / 12.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertial" params="mass radius length *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${mass}"/>
      <inertia
        ixx="${mass * (3.0 * radius * radius + length * length) / 12.0}"
        ixy="0.0"
        ixz="0.0"
        iyy="${mass * (3.0 * radius * radius + length * length) / 12.0}"
        iyz="0.0"
        izz="${mass * radius * radius / 2.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="sphere_inertial" params="mass radius *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${mass}"/>
      <inertia
        ixx="${2.0 * mass * radius * radius / 5.0}"
        ixy="0.0"
        ixz="0.0"
        iyy="${2.0 * mass * radius * radius / 5.0}"
        iyz="0.0"
        izz="${2.0 * mass * radius * radius / 5.0}"/>
    </inertial>
  </xacro:macro>

  <link name="base_footprint"/>

  <joint name="footprint_to_base" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${base_z_offset}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <geometry>
        <box size="${base_len} ${base_width} ${base_height}"/>
      </geometry>
      <material name="plate_gray"/>
    </visual>

    <collision>
      <geometry>
        <box size="${base_len} ${base_width} ${base_height}"/>
      </geometry>
    </collision>

    <xacro:box_inertial mass="${base_mass}" x="${base_len}" y="${base_width}" z="${base_height}">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:box_inertial>
  </link>

  <gazebo reference="base_link">
    <material>Gazebo/Grey</material>
  </gazebo>

</robot>